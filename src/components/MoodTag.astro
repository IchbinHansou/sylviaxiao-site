---
interface Props {
  mood: 'Hopeful' | 'Reflective' | 'Grateful' | 'Healing' | 'Contemplative' | 'Vulnerable';
}

const { mood } = Astro.props;

// 定义每种心情的颜色
const moodColors = {
  'Hopeful': 'bg-yellow-100 text-yellow-700 border-yellow-200',
  'Reflective': 'bg-blue-100 text-blue-700 border-blue-200',
  'Grateful': 'bg-pink-100 text-pink-700 border-pink-200',
  'Healing': 'bg-green-100 text-green-700 border-green-200',
  'Contemplative': 'bg-purple-100 text-purple-700 border-purple-200',
  'Vulnerable': 'bg-rose-100 text-rose-700 border-rose-200',
};

// 深色模式颜色
const moodColorsDark = {
  'Hopeful': 'dark:bg-yellow-900/20 dark:text-yellow-300 dark:border-yellow-700/30',
  'Reflective': 'dark:bg-blue-900/20 dark:text-blue-300 dark:border-blue-700/30',
  'Grateful': 'dark:bg-pink-900/20 dark:text-pink-300 dark:border-pink-700/30',
  'Healing': 'dark:bg-green-900/20 dark:text-green-300 dark:border-green-700/30',
  'Contemplative': 'dark:bg-purple-900/20 dark:text-purple-300 dark:border-purple-700/30',
  'Vulnerable': 'dark:bg-rose-900/20 dark:text-rose-300 dark:border-rose-700/30',
};

const colorClass = `${moodColors[mood]} ${moodColorsDark[mood]}`;
---

<span class={`mood-tag ${colorClass}`}>
  {mood}
</span>

<style>
  .mood-tag {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    border: 1px solid;
    font-size: 0.85rem;
    font-weight: 500;
    font-family: "PingFang SC", -apple-system, BlinkMacSystemFont, sans-serif;
    letter-spacing: 0.3px;
    transition: all 0.2s ease;
  }
  
  .mood-tag:hover {
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }
</style>

