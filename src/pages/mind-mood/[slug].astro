---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/MindMoodLayout.astro";
import MoodTag from "../../components/MoodTag.astro";

export async function getStaticPaths() {
  const posts = await getCollection("mindMood");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const data = post.data;
const { Content } = await render(post);
---

<Layout title={`${data.title} | Mind & Mood`} description={data.excerpt}>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=DM+Serif+Display:ital@0;1&family=Noto+Serif+SC:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- 全局段落样式覆盖 -->
  <style is:global>
    article.dream-content p,
    article.dream-content > * p,
    .dream-content p,
    .dream-content * p {
      font-family: 'Noto Serif SC', 'STSong', 'SimSun', serif !important;
      font-size: 1.1rem !important;
      line-height: 2.4 !important;
      color: #374151 !important;
      margin: 0 0 0 0 !important;
      text-align: justify !important;
      text-indent: 2em !important;
      font-weight: 400 !important;
      letter-spacing: 0.03em !important;
    }
    
    /* 引用块内不缩进 */
    .quote p,
    .quote * p,
    blockquote p,
    blockquote * p {
      text-indent: 0 !important;
    }
  </style>
  
  <!-- 动态背景 -->
  <div class="dream-background">
    <div class="floating-lights"></div>
    <div class="gradient-orbs"></div>
  </div>

  <!-- 主要内容 -->
  <main class="dream-container">
    <div class="article-wrapper">
    <!-- 面包屑导航 + 心情标签 -->
    <nav class="dream-breadcrumb">
      <div class="breadcrumb-left">
      <a href="/mind-mood" class="breadcrumb-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9,22 9,12 15,12 15,22"/>
        </svg>
          Mind & Mood
      </a>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <polyline points="9,18 15,12 9,6"/>
      </svg>
      <span class="breadcrumb-current">{data.title}</span>
      </div>
      <div class="breadcrumb-right">
        <MoodTag mood={data.mood} />
      </div>
    </nav>

    <!-- 文章头部 -->
    <header class="dream-header">
      <h1 class="dream-title">
        {data.title}
      </h1>
      
      <div class="dream-date">
          {new Date(data.date).toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric"
          })}
      </div>
      
      <p class="dream-excerpt">
        {data.excerpt}
      </p>
    </header>

    <!-- 文章内容 -->
    <article class="dream-content">
      <Content />
    </article>
    
    <!-- 尾注板块 -->
    <section class="endnotes-section">
      <h2 class="endnotes-title">尾注</h2>
      <div class="endnotes-content">
        <p>M.Y. 是我第一次尝试写作时拟定的组合名，which is Mary & Yuki 的缩写。</p>
        
        <p>上次小王到我家玩，我才发现她某个平台的密码依然有这个元素，内心像被什么轻轻敲了一下。</p>
        
        <p>第一次上传自己的作品是 2010 年左右，在新浪博客，用的笔名是 "初夏"。</p>
        
        <p>我一直非常喜欢这个名字，喜欢还不十分炎热的夏天，吃着西瓜在空调房里练琴的夏天，在一树蝉鸣里渐渐睡去的夏天，向往去东京看花火祭的夏天。</p>
        
        <p>所以，让一切reset在夏天开始吧。</p>
      </div>
    </section>

    <!-- 文章底部 -->
    <footer class="dream-footer">
      {data.tags && data.tags.length > 0 && (
        <div class="dream-tags">
          {data.tags.map((tag) => (
            <span class="dream-tag">{tag}</span>
          ))}
        </div>
      )}
      
      {data.weiboOriginal && (
        <div class="weibo-notice">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M9.8 20.2c-4.8 0-8.7-3.2-8.7-7.1 0-2.4 1.3-4.8 3.5-6.6.4-.3.9-.2 1.1.2.2.4.1.9-.3 1.1-1.8 1.5-2.8 3.4-2.8 5.3 0 3.1 3.1 5.6 7 5.6 3.8 0 7-2.5 7-5.6 0-1.4-.6-2.8-1.7-3.9-.3-.3-.3-.8 0-1.1.3-.3.8-.3 1.1 0 1.4 1.4 2.1 3.1 2.1 5 0 3.9-3.9 7.1-8.7 7.1zm2.3-8.4c-.3 0-.5-.1-.7-.3-.3-.3-.3-.8 0-1.1l4.7-4.7c.3-.3.8-.3 1.1 0 .3.3.3.8 0 1.1l-4.7 4.7c-.2.2-.4.3-.4.3z"/>
          </svg>
          Originally written on Weibo, revised for web publication
        </div>
      )}
      
      <div class="dream-copyright">
        © {new Date().getFullYear()} Sylvia Xiao
      </div>
    </footer>
    </div>
  </main>

  <!-- 浮动导航按钮 -->
  <nav class="floating-nav">
    <button class="nav-btn prev-btn" onclick="history.back()">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
    </button>
    <button class="nav-btn next-btn" onclick="history.forward()">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </button>
  </nav>
</Layout>

<style>
  /* 梦境色彩变量 */
  :root {
    --dream-lavender: #f8f4ff;
    --dream-pink: #fdf2f8;
    --dream-moon: #fefefe;
    --dream-purple: #e0d4ff;
    --dream-accent: #c4b5fd;
    --dream-text: #5b21b6;
    --dream-muted: #7c3aed;
    --dream-shadow: rgba(139, 92, 246, 0.1);
    --dream-glow: rgba(196, 181, 253, 0.3);
  }

  /* 动态背景 - 保留原配色 */
  .dream-background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    background: linear-gradient(135deg, 
      var(--dream-lavender) 0%, 
      var(--dream-pink) 35%, 
      var(--dream-moon) 70%, 
      var(--dream-lavender) 100%);
    background-size: 400% 400%;
    animation: dreamFlow 20s ease-in-out infinite;
  }

  @keyframes dreamFlow {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  /* 浮动光线 */
  .floating-lights {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 20% 30%, var(--dream-glow) 0%, transparent 50%),
                radial-gradient(circle at 80% 70%, var(--dream-glow) 0%, transparent 50%),
                radial-gradient(circle at 50% 50%, var(--dream-glow) 0%, transparent 30%);
    animation: floatLights 15s ease-in-out infinite;
  }

  @keyframes floatLights {
    0%, 100% { opacity: 0.3; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(1.1); }
  }

  /* 渐变球体 */
  .gradient-orbs {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 10% 20%, rgba(196, 181, 253, 0.2) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(196, 181, 253, 0.15) 0%, transparent 40%);
    animation: orbFloat 25s linear infinite;
  }

  @keyframes orbFloat {
    0% { transform: rotate(0deg) scale(1); }
    50% { transform: rotate(180deg) scale(1.2); }
    100% { transform: rotate(360deg) scale(1); }
  }

  /* 主容器 */
  .dream-container {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    padding: 3rem 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* 文章容器 - 半透明白色背景 */
  .article-wrapper {
    background: rgba(255, 255, 255, 0.85);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    border-radius: 8px;
    padding: 3rem;
    box-shadow: 0 4px 24px rgba(91, 33, 182, 0.08);
  }

  /* 面包屑导航 - 杂志风格 */
  .dream-breadcrumb {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 3rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(91, 33, 182, 0.15);
    font-family: "Inter", -apple-system, sans-serif;
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0.3px;
    animation: fadeInUp 0.8s ease-out;
  }

  .breadcrumb-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1;
    min-width: 0;
  }
  
  .breadcrumb-right {
    flex-shrink: 0;
  }

  .breadcrumb-link {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: #6b7280;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb-link:hover {
    color: #5b21b6;
  }
  
  .breadcrumb-link svg {
    width: 16px;
    height: 16px;
  }

  .breadcrumb-current {
    color: #9ca3af;
    font-weight: 400;
    max-width: 400px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  
  .breadcrumb-left > svg {
    width: 14px;
    height: 14px;
    color: #d1d5db;
    flex-shrink: 0;
  }

  /* 文章头部 */
  .dream-header {
    text-align: center;
    margin-bottom: 4rem;
    animation: fadeInUp 1s ease-out 0.2s both;
  }

  .dream-date {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    color: #9ca3af;
    font-weight: 400;
    letter-spacing: 0.5px;
    margin: 1rem 0 2rem;
  }

  /* 文章标题 - 杂志风格 */
  .dream-title {
    font-family: 'DM Serif Display', serif;
    font-size: 3.5rem;
    font-weight: 400;
    line-height: 1.2;
    margin: 0 0 1.5rem;
    color: #1f2937;
    letter-spacing: -0.02em;
  }

  /* 文章摘要 - 杂志风格 */
  .dream-excerpt {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.25rem;
    line-height: 1.7;
    color: #6b7280;
    font-style: italic;
    max-width: 680px;
    margin: 0 auto;
    padding: 1.5rem 0;
    border-left: 3px solid #5b21b6;
    padding-left: 1.5rem;
    animation: fadeInUp 1.2s ease-out 0.4s both;
  }

  /* 文章内容 - 杂志风格 */
  .dream-content {
    background: transparent;
    padding: 0;
    margin: 0 auto;
    position: relative;
    animation: fadeInUp 1.4s ease-out 0.6s both;
  }

  /* 内容样式 */
  .dream-content h2 {
    font-family: 'DM Serif Display', serif;
    font-size: 2.2rem;
    font-weight: 400;
    color: var(--dream-text);
    margin: 3rem 0 1.5rem;
    letter-spacing: 0.02em;
    text-shadow: 0 1px 10px var(--dream-glow);
  }

  .dream-content h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.6rem;
    font-weight: 500;
    color: var(--dream-text);
    margin: 2.5rem 0 1rem;
    letter-spacing: 0.01em;
  }

  /* 所有段落样式 - 强制应用 */
  .dream-content p,
  .dream-content > div p,
  .dream-content > p,
  article.dream-content p,
  article.dream-content > div p,
  article p,
  article > div p {
    font-family: 'Noto Serif SC', 'STSong', 'SimSun', serif !important;
    font-size: 1.1rem !important;
    line-height: 2 !important;
    color: #374151 !important;
    margin-bottom: 1.5rem !important;
    text-align: justify !important;
    text-indent: 2em !important;
    font-weight: 400 !important;
    letter-spacing: 0.03em !important;
  }
  
  /* 引用块、尾注内的段落不缩进 */
  .dream-content .quote p,
  .dream-content .note p,
  .dream-content blockquote p,
  .quote p,
  .note p,
  blockquote p,
  article .quote p,
  article .note p,
  article blockquote p {
    text-indent: 0 !important;
  }

  .dream-content blockquote {
    margin: 3rem 0;
    padding: 2.5rem 3rem;
    background: rgba(248, 244, 255, 0.6);
    border-left: 4px solid var(--dream-accent);
    border-radius: 0 20px 20px 0;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.3rem;
    font-style: italic;
    line-height: 1.7;
    color: var(--dream-text);
    position: relative;
    box-shadow: 0 4px 20px var(--dream-shadow);
  }

  .dream-content blockquote::before {
    content: '"';
    position: absolute;
    top: -0.5rem;
    left: 1.5rem;
    font-size: 5rem;
    color: var(--dream-accent);
    opacity: 0.3;
    font-family: 'DM Serif Display', serif;
  }

  /* 引用框 - 浅紫色方框 */
  .quote-box {
    margin: 1.5rem 0;
    padding: 1em 1.4em;
    background: rgba(240, 240, 255, 0.5);
    border-left: 3px solid #b5a8e5;
    border-radius: 8px;
  }

  .quote-box p {
    margin: 0.8em 0 !important;
    line-height: 1.9 !important;
    text-indent: 0 !important;
    font-size: 1rem !important;
  }

  .quote-box p:first-child {
    margin-top: 0 !important;
  }

  .quote-box p:last-child {
    margin-bottom: 0 !important;
  }

  /* 歌词引用框 - iOS/Spotify风格 */
  .lyrics-quote {
    background: rgba(139, 92, 246, 0.08);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(139, 92, 246, 0.15);
    border-radius: 16px;
    padding: 1.5rem 2rem;
    margin: 2rem 0;
    position: relative;
    box-shadow: 0 8px 32px rgba(139, 92, 246, 0.1);
  }

  .lyrics-quote::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, 
      rgba(196, 181, 253, 0.05) 0%, 
      rgba(139, 92, 246, 0.08) 50%, 
      rgba(196, 181, 253, 0.05) 100%);
    border-radius: 16px;
    z-index: -1;
  }

  .lyrics-quote p {
    margin: 0.5rem 0;
    font-family: 'Noto Serif SC', 'STSong', 'SimSun', serif;
    font-size: 1.1rem;
    line-height: 1.8;
    color: rgba(139, 92, 246, 0.9);
    font-weight: 400;
    letter-spacing: 0.02em;
    text-indent: 0 !important;
  }

  .lyrics-quote p:first-child {
    margin-top: 0;
  }

  .lyrics-quote p:last-child {
    margin-bottom: 0;
  }

  /* 简洁音乐播放器样式 */
  .compact-music-player {
    background: rgba(139, 92, 246, 0.06);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(139, 92, 246, 0.12);
    border-radius: 12px;
    padding: 0.8rem 1.2rem;
    margin: 1.5rem 0;
    max-width: 300px;
    box-shadow: 0 4px 16px rgba(139, 92, 246, 0.08);
  }

  .player-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .song-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    flex: 1;
  }

  .song-title {
    font-family: 'Noto Serif SC', 'STSong', 'SimSun', serif;
    font-size: 0.95rem;
    font-weight: 500;
    color: rgba(139, 92, 246, 0.9);
    line-height: 1.3;
  }

  .artist-name {
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    color: rgba(139, 92, 246, 0.6);
    font-weight: 400;
  }

  .play-button {
    width: 32px;
    height: 32px;
    background: rgba(139, 92, 246, 0.1);
    border: 1px solid rgba(139, 92, 246, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    color: rgba(139, 92, 246, 0.8);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .play-button:hover {
    background: rgba(139, 92, 246, 0.15);
    transform: scale(1.05);
  }

  .dream-content img {
    max-width: 100%;
    height: auto;
    border-radius: 20px;
    margin: 2rem 0;
    box-shadow: 0 8px 32px var(--dream-shadow);
    transition: all 0.3s ease;
  }

  .dream-content img:hover {
    transform: scale(1.02);
    box-shadow: 0 12px 40px var(--dream-shadow);
  }

  .dream-content strong {
    color: var(--dream-text);
    font-weight: 600;
  }

  .dream-content a {
    color: var(--dream-text);
    text-decoration: underline;
    text-decoration-color: var(--dream-accent);
    text-underline-offset: 3px;
    transition: all 0.2s ease;
  }

  .dream-content a:hover {
    text-decoration-color: var(--dream-text);
    color: var(--dream-text);
  }

  /* 文章主体容器 */
  .article-body {
    max-width: 100%;
  }

  /* 艺术分隔符样式 */
  .artistic-divider {
    margin: 5rem 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .divider-content {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .divider-line {
    width: 60px;
    height: 1px;
    background: linear-gradient(90deg, 
      transparent 0%, 
      rgba(196, 181, 253, 0.3) 20%, 
      rgba(196, 181, 253, 0.6) 50%, 
      rgba(196, 181, 253, 0.3) 80%, 
      transparent 100%);
    position: relative;
  }

  .divider-line::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, 
      transparent 0%, 
      rgba(196, 181, 253, 0.1) 20%, 
      rgba(196, 181, 253, 0.2) 50%, 
      rgba(196, 181, 253, 0.1) 80%, 
      transparent 100%);
    border-radius: 2px;
  }

  .divider-symbol {
    display: flex;
    gap: 0.3rem;
    align-items: center;
    justify-content: center;
  }

  .divider-symbol .dot {
    width: 4px;
    height: 4px;
    background: rgba(196, 181, 253, 0.4);
    border-radius: 50%;
    animation: symbolGlow 4s ease-in-out infinite;
  }

  .divider-symbol .dot:nth-child(1) {
    animation-delay: 0s;
  }

  .divider-symbol .dot:nth-child(2) {
    animation-delay: 0.1s;
  }

  .divider-symbol .dot:nth-child(3) {
    animation-delay: 0.2s;
  }

  @keyframes symbolGlow {
    0%, 100% { 
      opacity: 0.6; 
      transform: scale(1);
    }
    50% { 
      opacity: 1; 
      transform: scale(1.1);
    }
  }

  /* 基础段落样式 */
  .article-body p {
    margin: 1.2em 0 !important;
    line-height: 1.9 !important;
    text-indent: 2em !important;
    font-family: 'Noto Serif SC', 'STSong', 'SimSun', serif !important;
    font-size: 1.1rem !important;
    color: #374151 !important;
    letter-spacing: 0.03em !important;
  }

  /* 章节分隔符样式 - 虚线 + emoji */
  .chapter-divider {
    margin: 2em 0;
    border-top: 1px dashed rgba(180, 160, 230, 0.4);
    position: relative;
    text-align: center;
  }

  .divider-emoji {
    display: inline-block;
    background: rgba(255, 255, 255, 0.9);
    padding: 0 1em;
    position: relative;
    top: -0.6em;
    font-size: 1rem;
    color: rgba(196, 181, 253, 0.5);
  }

  @media (prefers-color-scheme: dark) {
    .divider-emoji {
      background: rgba(26, 26, 26, 0.9);
    }
  }

  /* 章节内容区域 */
  .body-section {
    margin: 3rem 0;
    padding: 0;
  }

  .body-section:first-child {
    margin-top: 0;
  }

  .body-section:last-child {
    margin-bottom: 0;
  }

  /* 确保body-section内的段落样式正确应用 */
  .body-section p {
    font-family: 'Noto Serif SC', 'STSong', 'SimSun', serif !important;
    text-indent: 2em !important;
    line-height: 2 !important;
    letter-spacing: 0.03em !important;
    font-size: 1.1rem !important;
    color: #374151 !important;
    margin: 0 !important;
  }

  .chapter-divider::before {
    content: '';
    position: absolute;
    top: -0.5px;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, 
      transparent 0%, 
      rgba(196, 181, 253, 0.08) 20%, 
      rgba(196, 181, 253, 0.12) 50%, 
      rgba(196, 181, 253, 0.08) 80%, 
      transparent 100%);
    border-radius: 1px;
  }

