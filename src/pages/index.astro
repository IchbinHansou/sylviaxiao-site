          0 8px 32px rgba(0, 0, 0, 0.1),
          0 1px 0 rgba(255, 255, 255, 0.5) inset,
          0 -1px 0 rgba(0, 0, 0, 0.05) inset;
        overflow: hidden;
        position: relative;
        max-height: 300px;
        transition: all 0.3s ease;
      }
      
      /* iOS风格窗口标题栏 */
      .updates-header {
        background: rgba(248, 248, 248, 0.8);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        padding: 12px 16px;
        border-bottom: 1px solid rgba(0, 0, 0, 0.1);
        display: flex;
        align-items: center;
        gap: 8px;
        position: sticky;
        top: 0;
        z-index: 10;
      }
      
      /* iOS风格窗口控制按钮 */
      .window-controls {
        display: flex;
        gap: 6px;
      }
      
      .window-btn {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        border: none;
        cursor: pointer;
      }
      
      .window-btn.close { background: #ff5f57; }
      .window-btn.minimize { background: #ffbd2e; }
      .window-btn.maximize { background: #28ca42; }
      
      .window-title {
        font-size: 14px;
        font-weight: 600;
        color: #1d1d1f;
        margin-left: 8px;
      }
      
      /* iOS风格滚动内容 */
      .updates-content {
        padding: 16px;
        max-height: 240px;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: rgba(0, 0, 0, 0.2) transparent;
      }
      
      .updates-content::-webkit-scrollbar {
        width: 6px;
      }
      
      .updates-content::-webkit-scrollbar-track {
        background: transparent;
      }
      
      .updates-content::-webkit-scrollbar-thumb {
        background: rgba(0, 0, 0, 0.2);
        border-radius: 3px;
      }
      
      .updates-content::-webkit-scrollbar-thumb:hover {
        background: rgba(0, 0, 0, 0.3);
      }
      
      .updates-list {
        margin: 0;
        padding: 0;
        list-style: none;
      }
      
      .update-item {
        padding: 12px 0;
