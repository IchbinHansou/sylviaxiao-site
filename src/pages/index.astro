    <!-- 语言切换 + 像素动画交互 -->
    <script type="module">
      // 简单选择器
      const $ = (s) => document.querySelector(s);

      const btn = document.getElementById('langBtn');
      let en = true;

      // 像素动画交互
      const pixelAnimation = document.getElementById('pixelAnimation');
      const animationHint = document.getElementById('animationHint');
      let isAnimating = false;

      // 浇水动画函数
      function startWateringAnimation() {
        if (isAnimating) return;
        
        isAnimating = true;
        pixelAnimation.classList.add('watering');
        
        // 更新提示文字
        if (en) {
          animationHint.textContent = 'Watering... 💧';
        } else {
          animationHint.textContent = '浇水中... 💧';
        }
        
        // 动画结束后重置
        setTimeout(() => {
          pixelAnimation.classList.remove('watering');
          isAnimating = false;
          
          // 恢复提示文字
          if (en) {
            animationHint.textContent = 'Click to water! 🌱';
          } else {
            animationHint.textContent = '点击浇水！🌱';
          }
        }, 1500);
      }

      function setEN() {
        document.documentElement.lang = 'en';
        $('#title').innerHTML = 'Sylvia (Zihan) Xiao <span class="divider">|</span> <span class="chinese-name">肖子涵</span>';
        $('#introTag').innerHTML = 'Also known as <em>Seluna</em> — my artistic persona exploring emotion, memory, and sound.';
        $('#artisticPersona').innerHTML = '<span class="persona-label">Artistic Persona</span>: <span class="seluna-name">Seluna</span> in LUNA Infinity Universe';
        $('#hello').textContent = 'Hi, I\'m Sylvia 🌲';
        $('#lead').textContent =
          'I explore how learning, emotion, and technology intertwine — designing systems that help people think, feel, and heal.';
        $('#research').textContent = 'Research';
        $('#researchNote').textContent = 'AI for empathy, computational psycholinguistics';
        $('#teaching').textContent = 'Teaching';
        $('#teachingNote').textContent = 'Narrative learning design, interdisciplinary education';
        $('#creative').textContent = 'Projects';
        $('#creativeNote').textContent = 'AURA, AI Bella, LUNA Infinity';
        btn.textContent = '中文';
      }

      function setZH() {
        document.documentElement.lang = 'zh';
        $('#title').innerHTML = '肖子涵 Sylvia (Zihan) Xiao';
        $('#introTag').innerHTML = '也被称为<em>Seluna</em>——我的艺术人格，探索情感、记忆和声音。';
        $('#artisticPersona').innerHTML = '<span class="persona-label">艺术人格</span>: <span class="seluna-name">Seluna</span> in LUNA Infinity Universe';
        $('#hello').textContent = '你好，我是肖子涵 🌲';
        $('#lead').textContent =
          '我探索学习、情感与技术如何交织——设计帮助人们思考、感受和治愈的系统。';
        $('#research').textContent = '研究';
        $('#researchNote').textContent = 'AI共情、计算心理语言学';
        $('#teaching').textContent = '教学';
        $('#teachingNote').textContent = '叙事学习设计、跨学科教育';
        $('#creative').textContent = '项目';
        $('#creativeNote').textContent = 'AURA、AI Bella、LUNA Infinity';
        btn.textContent = 'EN';
      }

      // 初始英文
      setEN();

      // 语言切换
      btn?.addEventListener('click', () => {
        en = !en;
        if (en) setEN(); else setZH();
      });

      // 像素动画点击事件
      pixelAnimation?.addEventListener('click', startWateringAnimation);
      
      // 键盘支持（空格键触发浇水）
      document.addEventListener('keydown', (e) => {
        if (e.code === 'Space' && document.activeElement === pixelAnimation) {
          e.preventDefault();
          startWateringAnimation();
        }
      });
      
      // 让像素动画区域可以获得焦点
      pixelAnimation?.setAttribute('tabindex', '0');
      pixelAnimation?.setAttribute('role', 'button');
      pixelAnimation?.setAttribute('aria-label', 'Click to water the tree');
    </script>
