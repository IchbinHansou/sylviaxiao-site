---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
---
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Sylvia Xiao 🌙｜Designing Healing through Learning</title>

    <!-- 字体：EB Garamond + Inter + Poppins + Nunito -->
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@500;600;700&family=Inter:wght@300;400;500;600&family=Poppins:wght@400;500;600&family=Nunito:wght@400;500;600&display=swap" rel="stylesheet">

    <style>
      /* ===== 色板：莫奈柔和彩 + 暗色适配 ===== */
      :root{
        --fg:#1e2228; --muted:#5c6575; --line:#00000018;
        --g1:#f6e6e4; --g2:#e2f0f5; --g3:#f4f6db; --g4:#e9f7ef; --g5:#f8ecf2;
        --link:#5c6cff; --max:980px; --pad:22px;
      }
      @media (prefers-color-scheme: dark){
        :root{
          --fg:#e8e9ed; --muted:#a7abb7; --line:#ffffff22;
          --g1:#151821; --g2:#1e2432; --g3:#202634; --g4:#1a2229; --g5:#232033;
          --link:#92a8ff;
        }
        
        .chinese-name{
          color:#e0e0e0;
        }
        
        .wrap{ 
          background: rgba(28, 28, 30, 0.15);
          border: 1px solid rgba(255, 255, 255, 0.1);
          box-shadow: 
            0 8px 32px rgba(0, 0, 0, 0.3),
            0 1px 0 rgba(255, 255, 255, 0.1) inset,
            0 -1px 0 rgba(0, 0, 0, 0.2) inset;
        }
        
        /* 深色模式导航栏 */
        nav a:hover {
          background: color-mix(in oklab, #374151 60%, transparent);
          border-color: rgba(255, 255, 255, 0.1);
        }
        
        nav a[aria-current="page"] {
          background: color-mix(in oklab, #374151 70%, transparent);
          border-color: rgba(255, 255, 255, 0.1);
        }
        
        .intro-tag{
          background:rgba(255,255,255,0.15);
          border:1px solid rgba(255,255,255,0.25);
          box-shadow:0 8px 32px rgba(0,0,0,0.3);
        }
        
        .intro-tag:hover{
          background:rgba(255,255,255,0.2);
          box-shadow:0 12px 40px rgba(0,0,0,0.4);
        }
        
        .navWrap::before{
          background:linear-gradient(135deg, 
            rgba(255,182,193,0.2) 0%,
            rgba(173,216,230,0.2) 25%,
            rgba(144,238,144,0.2) 50%,
            rgba(255,218,185,0.2) 75%,
            rgba(255,182,193,0.2) 100%
          );
        }
      }

      *{ box-sizing:border-box }
      html,body{ height:100% }
      body{
        margin:0; color:var(--fg);
        font:16px/1.7 Inter, system-ui, -apple-system, Segoe UI, Arial, sans-serif;
        /* 莫奈渐变 + 固定视差 */
        background: linear-gradient(135deg,var(--g1) 0%,var(--g2) 25%,var(--g3) 50%,var(--g4) 75%,var(--g5) 100%);
        background-attachment: fixed;
        min-height: 100vh;
        padding: 0 20px;
      }
      /* 细腻噪点 + 极淡角落色团（质感） */
      .bg-noise{ position:fixed; inset:0; z-index:-1; pointer-events:none;
        background-image:
          radial-gradient(1100px 600px at 85% 70%, color-mix(in oklab,#d9e2ff 18%, transparent), transparent 70%),
          radial-gradient(900px 500px at 12% 18%, color-mix(in oklab,#ffe7f4 16%, transparent), transparent 65%),
          radial-gradient(1px 1px at 25% 35%, #00000014 1px, transparent 1px),
          radial-gradient(1px 1px at 60% 70%, #00000014 1px, transparent 1px);
        background-size: auto, auto, 180px 180px, 220px 220px;
        mix-blend-mode: soft-light; opacity:.35;
      }

      .wrap{ 
        max-width:var(--max); 
        margin:0 auto; 
        padding:0 var(--pad) 80px; 
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-radius: 24px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 
          0 8px 32px rgba(0, 0, 0, 0.1),
          0 1px 0 rgba(255, 255, 255, 0.5) inset,
          0 -1px 0 rgba(0, 0, 0, 0.05) inset;
        margin-top: 20px;
        margin-bottom: 20px;
        position: relative;
        overflow: hidden;
      }

      /* 顶部：标题 + 语言切换 */
      .mast{ 
        display:flex; 
        justify-content:center; 
        align-items:flex-start; 
        gap:12px; 
        padding:40px 0 20px; 
        position:relative; 
        text-align:center;
      }
      
      /* 语言切换按钮绝对定位到右上角 */
      .lang{
        position:absolute;
        top:40px;
        right:0;
      }
      
      /* 主标题 */
      .site-title{ 
        font-family:"EB Garamond",serif; 
        font-size:2.6rem;
        font-weight:700;
        line-height:1.1; 
        margin:0 0 20px 0; 
        letter-spacing:0.4px;
        color:#1a1a1a;
      }
      
      /* 中文名字样式 */
      .chinese-name{ 
        font-family:"FZShuSong-Z01", "方正书宋_GBK", "方正书宋", "FZShuSong", serif;
        font-weight:400;
      }
      
      /* 分隔符 */
      .divider{
        margin:0 8px;
        color:#666;
        font-weight:400;
      }
      
      /* 副标题 */
      .site-subtitle{
        font-family:"EB Garamond",serif;
        font-size:1.2rem;
        font-weight:400;
        font-style:normal;
        color:#555;
        opacity:0.85;
        margin:16px 0 2px 0;
        line-height:1.4;
      }
      
      /* 分隔线 */
      .header-divider{
        width:80px;
        height:1px;
        background:#e8e8e8;
        opacity:0.7;
        margin:0 auto 20px auto;
      }
      
      /* LUNA 方框样式 */
      .luna-box{
        display:inline-block;
        background:linear-gradient(90deg,
          #f8b7d8 0%,   /* 粉 */
          #8db6ff 16%,  /* 蓝 */
          #8fe3c4 32%,  /* 绿 */
          #f6e27a 48%,  /* 黄 */
          #f59f50 64%,  /* 橙 */
          #c7a6ee 80%,  /* 紫 */
          #f8b7d8 100%  /* 回环 */
        );
        background-size:300% 100%;
        animation:lunaFlow 20s linear infinite;
        color:#fff;
        font-weight:700;
        font-family:"EB Garamond",serif;
        padding:4px 8px;
        border-radius:4px;
        text-shadow:0 1px 2px rgba(0,0,0,0.3);
        margin-left:4px;
      }
      
      /* LUNA 流光动画 */
      @keyframes lunaFlow{
        0%{ background-position:0% 50%; }
        100%{ background-position:300% 50%; }
      }
      
      /* 无动画偏好 */
      @media (prefers-reduced-motion: reduce){
        .luna-box{
          animation:none;
          background:linear-gradient(90deg,
            #d6c8f0 0%, #b7cdee 25%, #c8e4dc 50%, #f3e5b5 75%, #e9c4d2 100%
          );
        }
      }
      
      .subtitle{ margin:6px 0 0; color:var(--muted); }
      .lang{ border:1px solid var(--line); background:color-mix(in oklab,#fff 70%, transparent); color:var(--fg);
        padding:.42rem .9rem; border-radius:10px; cursor:pointer; transition:.2s transform,.2s box-shadow; }
      .lang:hover{ transform:translateY(-1px); box-shadow:0 6px 16px #00000014; }

      /* 粘性导航 */
      .navWrap{ 
        position:sticky; 
        top:20px; 
        z-index:40; 
        backdrop-filter:saturate(120%) blur(8px);
        border-top:1px solid rgba(255,255,255,0.2); 
        border-bottom:1px solid rgba(255,255,255,0.2);
        background:color-mix(in oklab,#ffffff 60%, transparent);
        position:relative;
        margin:0 20px;
        border-radius:12px;
        border:1px solid rgba(255,255,255,0.3);
        background-clip:padding-box;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
      }
      
      .navWrap::before{
        content:'';
        position:absolute;
        top:0;
        left:0;
        right:0;
        bottom:0;
        border-radius:16px;
        padding:2px;
        background:linear-gradient(135deg, 
          rgba(255,182,193,0.3) 0%,
          rgba(173,216,230,0.3) 25%,
          rgba(144,238,144,0.3) 50%,
          rgba(255,218,185,0.3) 75%,
          rgba(255,182,193,0.3) 100%
        );
        mask:linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        mask-composite:exclude;
        -webkit-mask:linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        -webkit-mask-composite:xor;
        z-index:-1;
      }
      
      nav{ 
        max-width:1140px; 
        margin:0 auto; 
        padding:6px 20px 8px 20px; 
        display:flex; 
        justify-content:space-between;
        align-items:center;
        gap:6px;
      }
      
      nav a{ 
        color:var(--muted); 
        text-decoration:none; 
        font-family:"PingFang SC", -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", sans-serif;
        font-size:0.95rem;
        font-weight:400;
        letter-spacing:0.3px;
        position:relative;
        transition:all 0.3s ease;
        padding:4px 8px;
        border-radius:4px;
        border:1px solid transparent;
        background:transparent;
        display:flex;
        align-items:center;
        justify-content:center;
        min-width:0;
        height:26px;
        text-align:center;
        flex:1;
        opacity:0.85;
      }
      
      nav a:hover{ 
        background:color-mix(in oklab, #f8f9fa 60%, transparent);
        border:1px solid var(--line);
        transform:translateY(-1px);
      }
      
      nav a[aria-current="page"]{
        background:color-mix(in oklab, #f8f9fa 70%, transparent);
        border:1px solid var(--line);
      }
      
      /* 响应式设计 */
      @media (max-width: 1024px) {
        .site-title{
          font-size:2.2rem;
        }
      }
      
      @media (max-width: 768px) {
        .site-title{
          font-size:2.0rem;
        }
        
        .site-subtitle{
          font-size:0.95rem;
        }
        
        .navWrap{
          margin:0 15px;
        }
        
        nav{
          grid-template-columns:repeat(2, 1fr);
          grid-template-rows:repeat(4, 1fr);
          gap:12px 20px;
          padding:6px 20px 16px 20px;
        }
        
        nav a{
          font-size:0.95rem;
          font-weight:400;
          letter-spacing:0.3px;
          min-width:100px;
          height:32px;
          padding:6px 12px;
        }
      }
      
      @media (max-width: 480px) {
        .site-title{
          font-size:1.7rem;
        }
        
        .navWrap{
          margin:0 10px;
        }
        
        nav{
          flex-wrap:wrap;
          gap:4px;
          padding:4px 12px 6px 12px;
        }
        
        nav a{
          min-height:32px;
          display:flex;
          align-items:center;
          justify-content:center;
          font-family:"PingFang SC", -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", sans-serif;
          font-size:0.8rem;
          font-weight:400;
          letter-spacing:0.3px;
          min-width:60px;
          height:28px;
          padding:2px 6px;
          flex:1 1 calc(25% - 3px);
        }
      }
      
      .icon{ width:16px; height:16px; opacity:.9; }

      /* Hero：左图右文（自适应） */
      .hero{ display:grid; grid-template-columns:300px 1fr; gap:24px; align-items:center; margin:40px 0 6px; }
      .photo{ max-width:300px; border-radius:16px; overflow:hidden; border:1px solid var(--line);
        box-shadow:0 12px 28px rgba(0,0,0,.16), 0 1px 0 rgba(255,255,255,.06) inset;
        background: color-mix(in oklab,#fff 6%, transparent); transform:translateZ(0); }
      .photo img{ width:100%; display:block; }
      h1{ font-family:"EB Garamond",serif; font-size:34px; margin:0 0 6px; }
      .tagline{ font-size:20px; color:var(--muted); margin:0 0 10px; }
      
      /* 学术论文风格的引言框 */
      .academic-quote {
        margin: 1.5rem 0;
        padding: 1.5rem 2rem;
        border: 2px solid var(--line);
        border-left: 4px solid #3b82f6;
        background: color-mix(in oklab, #ffffff 95%, transparent);
        border-radius: 0 8px 8px 0;
        font-family: "EB Garamond", serif;
        font-size: 18px;
        line-height: 1.6;
        color: var(--fg);
        position: relative;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
      }
      
      .academic-quote::before {
        content: '"';
        position: absolute;
        top: -5px;
        left: 15px;
        font-size: 48px;
        color: #3b82f6;
        font-family: "EB Garamond", serif;
        opacity: 0.3;
      }
      
      .academic-quote::after {
        content: '"';
        position: absolute;
        bottom: -15px;
        right: 15px;
        font-size: 48px;
        color: #3b82f6;
        font-family: "EB Garamond", serif;
        opacity: 0.3;
      }
      
      /* 深色模式下的学术引言框 */
      @media (prefers-color-scheme: dark) {
        .academic-quote {
          background: color-mix(in oklab, #1f2937 95%, transparent);
          border-color: rgba(255, 255, 255, 0.1);
          border-left-color: #60a5fa;
          box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
        }
        
        .academic-quote::before,
        .academic-quote::after {
          color: #60a5fa;
        }
      }
      
      .lead{ margin:8px 0 0; }
      
      /* 额外兴趣标签文字版 */
      .additional-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem;
        margin: 0.8rem 0 1.2rem;
        font-size: 14px;
        color: var(--muted);
      }
      
      .text-tag {
        padding: 0.2rem 0.5rem;
        background: color-mix(in oklab, #f8f9fa 60%, transparent);
        border: 1px solid var(--line);
        border-radius: 4px;
        font-weight: 500;
        transition: all 0.2s ease;
      }
      
      
      /* 深色模式下的文字标签 */
      @media (prefers-color-scheme: dark) {
        .text-tag {
          background: color-mix(in oklab, #374151 60%, transparent);
          border-color: rgba(255, 255, 255, 0.1);
        }
        
      }

      /* 兴趣胶囊 - 彩虹色渐变效果 */
      .pills{ display:flex; flex-wrap:wrap; gap:.5rem; margin:.4rem 0 1rem; }
      .pill{ padding:.3rem .7rem; border-radius:999px; border:1px solid var(--line); font-weight:600;
        background:color-mix(in oklab,#fff 60%, transparent); 
        transition:.3s transform,.3s box-shadow,.3s border-color,.3s background; 
        position:relative; overflow:hidden; }
      
      /* Creative Computing - 磨砂白色 */
      .pill.cc{ 
        background: rgba(255, 255, 255, 0.8);
        color: #1f2937;
        border: 1px solid rgba(255, 255, 255, 0.6);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1), 
                    0 0 0 1px rgba(255, 255, 255, 0.9) inset;
        backdrop-filter: blur(15px);
        text-shadow: none;
      }
      
      /* Computational Psycholinguistics - 磨砂白色 */
      .pill.cl{ 
        background: rgba(255, 255, 255, 0.8);
        color: #1f2937;
        border: 1px solid rgba(255, 255, 255, 0.6);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1), 
                    0 0 0 1px rgba(255, 255, 255, 0.9) inset;
        backdrop-filter: blur(15px);
        text-shadow: none;
      }
      
      /* Emotional Learning - 磨砂白色 */
      .pill.pl{ 
        background: rgba(255, 255, 255, 0.8);
        color: #1f2937;
        border: 1px solid rgba(255, 255, 255, 0.6);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1), 
                    0 0 0 1px rgba(255, 255, 255, 0.9) inset;
        backdrop-filter: blur(15px);
        text-shadow: none;
      }
      
      /* Narrative Design - 磨砂白色 */
      .pill.nlp{ 
        background: rgba(255, 255, 255, 0.8);
        color: #1f2937;
        border: 1px solid rgba(255, 255, 255, 0.6);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1), 
                    0 0 0 1px rgba(255, 255, 255, 0.9) inset;
        backdrop-filter: blur(15px);
        text-shadow: none;
      }
      
      /* Human-Computer Interaction (HCI) - 磨砂白色 */
      .pill.ml{ 
        background: rgba(255, 255, 255, 0.8);
        color: #1f2937;
        border: 1px solid rgba(255, 255, 255, 0.6);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1), 
                    0 0 0 1px rgba(255, 255, 255, 0.9) inset;
        backdrop-filter: blur(15px);
        text-shadow: none;
      }

      /* Tier 2 - Secondary tags with muted colors */
      .pills.tier-2 {
        margin: 0.6rem 0 0.8rem;
      }

      /* Empathy - soft pink */
      .pill.tier2-empathy{ 
        background: rgba(251, 207, 232, 0.12);
        color: #dc2626;
        border: 1px solid rgba(220, 38, 38, 0.3);
        box-shadow: 0 2px 6px rgba(251, 207, 232, 0.15), 
                    0 0 0 1px rgba(255, 255, 255, 0.4) inset;
        backdrop-filter: blur(8px);
        text-shadow: 0 1px 2px rgba(255, 255, 255, 0.7);
      }
      
      /* Healing - 森林绿 */
      .pill.tier2-healing{ 
        background: rgba(167, 243, 208, 0.12);
        color: #16a34a;
        border: 1px solid rgba(22, 163, 74, 0.3);
        box-shadow: 0 2px 6px rgba(167, 243, 208, 0.15), 
                    0 0 0 1px rgba(255, 255, 255, 0.4) inset;
        backdrop-filter: blur(8px);
        text-shadow: 0 1px 2px rgba(255, 255, 255, 0.7);
      }
      
      /* Mental Health - 神秘紫 */
      .pill.tier2-mental{ 
        background: rgba(196, 181, 253, 0.12);
        color: #7c3aed;
        border: 1px solid rgba(124, 58, 237, 0.3);
        box-shadow: 0 2px 6px rgba(196, 181, 253, 0.15), 
                    0 0 0 1px rgba(255, 255, 255, 0.4) inset;
        backdrop-filter: blur(8px);
        text-shadow: 0 1px 2px rgba(255, 255, 255, 0.7);
      }
      
      /* AI Ethics - 湖水蓝 */
      .pill.tier2-ai{ 
        background: rgba(147, 197, 253, 0.12);
        color: #0284c7;
        border: 1px solid rgba(2, 132, 199, 0.3);
        box-shadow: 0 2px 6px rgba(147, 197, 253, 0.15), 
                    0 0 0 1px rgba(255, 255, 255, 0.4) inset;
        backdrop-filter: blur(8px);
        text-shadow: 0 1px 2px rgba(255, 255, 255, 0.7);
      }
      
      /* Affective Computing - 粉色 */
      .pill.tier2-games{ 
        background: rgba(251, 207, 232, 0.12);
        color: #ec4899;
        border: 1px solid rgba(236, 72, 153, 0.3);
        box-shadow: 0 2px 6px rgba(251, 207, 232, 0.15), 
                    0 0 0 1px rgba(255, 255, 255, 0.4) inset;
        backdrop-filter: blur(8px);
        text-shadow: 0 1px 2px rgba(255, 255, 255, 0.7);
      }
      
      /* Learning Games - 金黄色 */
      .pill.tier2-learning{ 
        background: rgba(254, 240, 138, 0.12);
        color: #d97706;
        border: 1px solid rgba(217, 119, 6, 0.3);
        box-shadow: 0 2px 6px rgba(254, 240, 138, 0.15), 
                    0 0 0 1px rgba(255, 255, 255, 0.4) inset;
        backdrop-filter: blur(8px);
        text-shadow: 0 1px 2px rgba(255, 255, 255, 0.7);
      }

      /* 三卡片 - 不同主题色 */
      .cards{ display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin:22px 0 0; }
      .card{ border:1px solid var(--line); border-radius:14px; padding:20px; text-decoration:none; color:var(--fg);
        background:color-mix(in oklab,#fff 65%, transparent); 
        transition:all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position:relative;
        overflow:hidden;
        cursor:pointer;
      }
      
      .card::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
        transition: left 0.5s;
      }
      
      .card:hover::before {
        left: 100%;
      }
      
      .card-icon {
        font-size: 24px;
        margin-right: 12px;
        display: inline-block;
        vertical-align: middle;
        transition: transform 0.3s ease;
      }
      
      .card:hover .card-icon {
        transform: scale(1.1);
      }
      
      .card-header {
        display: flex;
        align-items: center;
        margin-bottom: 8px;
      }
      
      /* Research卡片 - 学术蓝 */
      .card[href="/research"] .card-icon {
        color: #3b82f6;
      }
      .card[href="/research"]:hover{ 
        transform:translateY(-4px) scale(1.02); 
        box-shadow:0 15px 35px rgba(59, 130, 246, 0.2); 
        border-color:#3b82f6;
        background:color-mix(in oklab,#dbeafe 25%, transparent);
      }
      .card[href="/research"]:hover .card-icon {
        color: #1d4ed8;
      }
      
      /* Teaching卡片 - 教育绿 */
      .card[href="/teaching"] .card-icon {
        color: #10b981;
      }
      .card[href="/teaching"]:hover{ 
        transform:translateY(-4px) scale(1.02); 
        box-shadow:0 15px 35px rgba(16, 185, 129, 0.2); 
        border-color:#10b981;
        background:color-mix(in oklab,#d1fae5 25%, transparent);
      }
      .card[href="/teaching"]:hover .card-icon {
        color: #059669;
      }
      
      /* Projects卡片 - 深绿色 */
      .card[href="/projects"] .card-icon {
