        display: flex;
        align-items: flex-start;
        gap: 12px;
        transition: background-color 0.2s ease;
      }
      
      .update-item:last-child {
        border-bottom: none;
      }
      
      .update-item:hover {
        background: rgba(0, 0, 0, 0.02);
        margin: 0 -16px;
        padding: 12px 16px;
        border-radius: 8px;
      }
      
      .update-date {
        font-size: 12px;
        font-weight: 600;
        color: #007aff;
        background: rgba(0, 122, 255, 0.1);
        padding: 4px 8px;
        border-radius: 6px;
